# Documentation only: the application does not automatically load this file.
# Export values in your process environment using your secret-management method.
# Use separate local-gateway and detector credentials. Never commit real keys.
PII_GATEWAY_LOCAL_TOKEN=replace-with-local-gateway-token
PII_DETECTOR_URL=https://detector.example.invalid/v1/inspect
PII_DETECTOR_TOKEN=replace-with-detector-server-token
OPENAI_API_KEY=replace-with-your-openai-api-key
PII_MODEL_ID=replace-with-allowed-model-id
PII_GATEWAY_PORT=8765
# Optional absolute path; default: platform home/.local/state/ai-pii-gateway
# PII_STATE_DIR=/absolute/path/to/private/state
# Optional detector-only private CA; provider/system trust is unchanged.
# PII_DETECTOR_CA_FILE=/absolute/path/to/detector-ca.pem
# Host is fixed to 127.0.0.1; OpenAI destination and TLS verification are fixed.
# OPENAI_BASE_URL, OPENAI_API_BASE and PII_UPSTREAM_URL overrides are rejected.
