# Reference only: the entrypoint does not load .env or dotenv files.
# Export these variables explicitly in your shell or service manager.
PII_DETECTOR_TOKEN=replace-with-a-dedicated-inspection-server-token
PII_MODEL_PACKAGE=/absolute/path/to/verified-local-model-package
PII_DETECTOR_PORT=8766
# Exact values: cpu (default) or cuda. CUDA failures never fall back to CPU.
PII_DETECTOR_DEVICE=cpu

# Run from dev with the configured Python environment: python -m detector
# Binding is fixed to 127.0.0.1 and access logs are disabled.
# No host/TLS-disabling override is supported. External TLS termination and
# actual Ubuntu/GPU deployment remain separate, unverified steps.
