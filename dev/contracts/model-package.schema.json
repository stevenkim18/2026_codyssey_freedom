{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-pii-gateway:model-package:1.0",
  "x-owner": "B",
  "$defs": {
    "Artifacts": {
      "additionalProperties": false,
      "properties": {
        "weights": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Weights",
          "type": "array"
        },
        "config": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Config",
          "type": "string"
        },
        "tokenizer": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^\\S(?:.*\\S)?$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Tokenizer",
          "type": "array"
        },
        "license": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "License",
          "type": "string"
        },
        "evaluation": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Evaluation",
          "type": "string"
        }
      },
      "required": [
        "weights",
        "config",
        "tokenizer",
        "license",
        "evaluation"
      ],
      "title": "Artifacts",
      "type": "object"
    },
    "ModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "repo_id": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repo Id",
          "type": "string"
        },
        "revision": {
          "pattern": "^[a-f0-9]{40}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "repo_id",
        "revision"
      ],
      "title": "ModelIdentity",
      "type": "object"
    },
    "Preprocessing": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^\\S(?:.*\\S)?$",
          "title": "Version",
          "type": "string"
        },
        "normalization": {
          "const": "none",
          "title": "Normalization",
          "type": "string"
        },
        "offset_unit": {
          "const": "unicode_codepoint",
          "title": "Offset Unit",
          "type": "string"
        },
        "max_input_codepoints": {
          "maximum": 16000,
          "minimum": 1,
          "title": "Max Input Codepoints",
          "type": "integer"
        },
        "overflow": {
          "const": "reject",
          "title": "Overflow",
          "type": "string"
        }
      },
      "required": [
        "version",
        "normalization",
        "offset_unit",
        "max_input_codepoints",
        "overflow"
      ],
      "title": "Preprocessing",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "model_version": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Model Version",
      "type": "string"
    },
    "threshold_version": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "Threshold Version",
      "type": "string"
    },
    "model": {
      "$ref": "#/$defs/ModelIdentity"
    },
    "label_mapping": {
      "additionalProperties": {
        "maxLength": 256,
        "minLength": 1,
        "pattern": "^\\S(?:.*\\S)?$",
        "type": "string"
      },
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "KR_RRN",
          "CREDIT_CARD",
          "API_KEY",
          "PRIVATE_KEY",
          "PERSON",
          "EMAIL_ADDRESS",
          "KR_PHONE_NUMBER",
          "KR_BANK_ACCOUNT",
          "KR_LOCATION",
          "DATE_OF_BIRTH",
          "KR_DRIVER_LICENSE",
          "KR_PASSPORT",
          "KR_NHIS",
          "KR_VEHICLE_PLATE",
          "USERNAME",
          "PERSONAL_ATTRIBUTE",
          "ORGANIZATION",
          "URL",
          "IP_ADDRESS",
          "NRP"
        ]
      },
      "title": "Label Mapping",
      "type": "object"
    },
    "thresholds": {
      "additionalProperties": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "KR_RRN",
          "CREDIT_CARD",
          "API_KEY",
          "PRIVATE_KEY",
          "PERSON",
          "EMAIL_ADDRESS",
          "KR_PHONE_NUMBER",
          "KR_BANK_ACCOUNT",
          "KR_LOCATION",
          "DATE_OF_BIRTH",
          "KR_DRIVER_LICENSE",
          "KR_PASSPORT",
          "KR_NHIS",
          "KR_VEHICLE_PLATE",
          "USERNAME",
          "PERSONAL_ATTRIBUTE",
          "ORGANIZATION",
          "URL",
          "IP_ADDRESS",
          "NRP"
        ]
      },
      "title": "Thresholds",
      "type": "object"
    },
    "preprocessing": {
      "$ref": "#/$defs/Preprocessing"
    },
    "license_id": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "title": "License Id",
      "type": "string"
    },
    "artifacts": {
      "$ref": "#/$defs/Artifacts"
    },
    "files": {
      "additionalProperties": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
      },
      "minProperties": 1,
      "title": "Files",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "model_version",
    "threshold_version",
    "model",
    "label_mapping",
    "thresholds",
    "preprocessing",
    "license_id",
    "artifacts",
    "files"
  ],
  "title": "ModelPackage",
  "type": "object"
}
